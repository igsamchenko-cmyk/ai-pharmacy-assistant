{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'); for (const f of ['package-lock.json','yarn.lock']) fs.rmSync(f,{force:true}); if (!/^pnpm\\//.test(process.env.npm_config_user_agent||'')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:push": "pnpm --filter @workspace/db run push",
    "validate:import": "pnpm --filter @workspace/api-server run validate:import",
    "import:preview": "pnpm --filter @workspace/api-server run import:preview",
    "import:knowledge": "pnpm --filter @workspace/api-server run import:knowledge",
    "knowledge:backfill": "pnpm --filter @workspace/api-server run knowledge:backfill",
    "knowledge:runtime:verify": "pnpm --filter @workspace/api-server run knowledge:runtime:verify",
    "knowledge:quality:report": "pnpm --filter @workspace/api-server run knowledge:quality:report",
    "db:dev:up": "node scripts/docker-dev.mjs up",
    "db:dev:down": "node scripts/docker-dev.mjs down",
    "dev:db-runtime": "node scripts/dev-db-runtime.mjs",
    "knowledge:runtime:smoke": "pnpm --filter @workspace/api-server run knowledge:runtime:smoke",
    "knowledge:import:preview:all": "pnpm --filter @workspace/api-server run import:preview:all",
    "knowledge:import:validate:all": "pnpm --filter @workspace/api-server run import:validate:all",
    "knowledge:batches:generate": "pnpm --filter @workspace/api-server run generate:dictionary-batches"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  }
}
