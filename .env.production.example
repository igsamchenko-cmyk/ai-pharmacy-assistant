# Production private beta placeholders only. Do not commit real values.
NODE_VERSION=24.14.1
NODE_ENV=production

# Production uses verified OTP auth. Keep local provider only for development.
AUTH_PROVIDER=supabase
AUTH_REQUIRED=true
# Public users can use the pharmaceutical reference without signing in.
# Reviewer/admin tools still require an invited account.
PUBLIC_REFERENCE_ACCESS=true
INVITE_ONLY=true
# Optional cross-origin frontend origins. Same-origin requests work without this.
CORS_ALLOWED_ORIGINS=
ADMIN_EMAILS=
ALLOWED_EMAILS=
DISABLED_EMAILS=

DATABASE_URL=
KNOWLEDGE_DB_RUNTIME=true

AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_ENABLED=false
OPENAI_API_KEY=

# Public Supabase project URL and publishable/anon key; never use a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
