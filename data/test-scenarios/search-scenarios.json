{
  "version": "1.0-beta",
  "category": "search",
  "scenarios": [
    {
      "id": "search-nurofen-brand",
      "query": "Нурофен",
      "description": "Brand query used at the pharmacy counter.",
      "expected": {
        "hit": true,
        "topCatalogId": "nurofen-200",
        "normalizedInn": "Ібупрофен",
        "normalizedEnglish": "Ibuprofen",
        "resolvedStage": "dictionary",
        "ukrainian": true
      }
    },
    {
      "id": "search-paracetamol-inn",
