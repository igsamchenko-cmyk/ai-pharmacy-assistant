{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:knowledge": "tsx src/scripts/validate-knowledge.ts",
    "seed:knowledge": "tsx src/scripts/seed-knowledge.ts",
    "knowledge:backfill": "tsx src/scripts/knowledge-backfill.ts",
    "knowledge:runtime:verify": "tsx src/scripts/knowledge-runtime-verify.ts",
    "knowledge:quality:report": "tsx src/scripts/knowledge-quality-report.ts",
    "validate:import": "tsx src/scripts/validate-import.ts",
    "import:preview": "tsx src/scripts/import-preview.ts",
    "import:knowledge": "tsx src/scripts/import-knowledge.ts",
    "knowledge:runtime:smoke": "tsx src/scripts/knowledge-runtime-smoke.ts",
    "import:preview:all": "tsx src/scripts/import-preview-all-batches.ts",
    "import:validate:all": "tsx src/scripts/validate-dictionary-batches.ts",
    "generate:dictionary-batches": "tsx src/scripts/generate-dictionary-batches.ts",
    "knowledge:real-world:report": "tsx src/scripts/knowledge-real-world-report.ts",
    "knowledge:search:report": "tsx src/scripts/knowledge-search-report.ts",
    "knowledge:sources:discover": "tsx src/scripts/knowledge-sources-discover.ts",
    "knowledge:registry:preview": "tsx src/scripts/knowledge-registry-preview.ts",
    "knowledge:registry:import": "tsx src/scripts/knowledge-registry-import.ts",
    "knowledge:registry:product-db-smoke": "tsx src/scripts/knowledge-registry-product-db-smoke.ts",
    "knowledge:registry:production-report": "tsx src/scripts/knowledge-registry-production-report.ts",
    "knowledge:candidates:generate": "tsx src/scripts/knowledge-candidates-generate.ts",
    "knowledge:candidates:preview": "tsx src/scripts/knowledge-candidates-preview.ts",
    "knowledge:candidates:commit": "tsx src/scripts/knowledge-candidates-commit.ts",
    "knowledge:candidates:from-misses": "tsx src/scripts/knowledge-candidates-from-misses.ts",
    "knowledge:bulk-ingest:report": "tsx src/scripts/knowledge-bulk-ingest-report.ts",
    "beta:scenarios": "tsx src/scripts/beta-scenarios.ts",
    "beta:readiness": "tsx src/scripts/beta-readiness.ts",
    "deploy:verify": "tsx src/scripts/deploy-verify.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "openai": "^6.45.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
