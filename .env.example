# Local PostgreSQL dev profile. Safe defaults for local Docker only.
POSTGRES_USER=farmassist
POSTGRES_PASSWORD=farmassist_dev_password
POSTGRES_DB=farmassist
POSTGRES_PORT=5432
DATABASE_URL=postgresql://farmassist:farmassist_dev_password@localhost:5432/farmassist

# Static runtime remains the default. Set true only when testing DB runtime.
KNOWLEDGE_DB_RUNTIME=false

# Optional real-DB test gate. Keep false unless a local DB is running.
RUN_DB_TESTS=false

# Private beta access. Local development should keep AUTH_REQUIRED=false.
AUTH_PROVIDER=local
AUTH_REQUIRED=false
# Set true to open reference APIs while keeping reviewer/admin tools protected.
PUBLIC_REFERENCE_ACCESS=false
INVITE_ONLY=true
ADMIN_EMAILS=admin@example.com
ALLOWED_EMAILS=user@example.com,reviewer@example.com:reviewer
DISABLED_EMAILS=

# Supabase placeholders for a future hosted provider. Do not commit real keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
